{
  "name": "orbit-game-launcher",
  "version": "0.2.1",
  "private": true,
  "description": "Orbit — a fast, local-first desktop game launcher",
  "main": "src/main.cjs",
  "license": "MIT",
  "author": "Orbit",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.cjs",
    "bench": "node tests/performance.cjs",
    "check": "node scripts/check.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "lint": "npx --yes --package @biomejs/biome@2.6.2 biome lint src tests scripts --reporter=json --max-diagnostics=none | node scripts/lint-report.cjs",
    "bench:tracking": "node tests/tracking-performance.cjs",
    "test:renderer": "node tests/library-renderer.cjs",
    "test:experience": "node tests/experience-renderer.cjs",
    "test:controller": "node tests/controller-renderer.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.0",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "com.orbitlauncher.desktop",
    "productName": "Orbit Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": {
      "provider": "github",
      "owner": "j5bak928-a11y",
      "repo": "orbit-game-launcher",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
