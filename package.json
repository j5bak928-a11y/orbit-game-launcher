{
  "name": "orbit-game-launcher",
  "version": "0.3.5",
  "private": true,
  "description": "Orbit — a fast, local-first Rust desktop game launcher",
  "license": "MIT",
  "author": "Orbit",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-tauri-local-unsigned.ps1",
    "tauri:stage": "node scripts/prepare-tauri.cjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --test tests/*.test.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib",
    "check": "node scripts/check.cjs",
    "lint": "npx --yes --package @biomejs/biome@2.6.2 biome lint src tests scripts --reporter=json --max-diagnostics=none | node scripts/lint-report.cjs",
    "test:renderer": "node tests/library-renderer.cjs",
    "test:experience": "node tests/experience-renderer.cjs",
    "test:cinematic": "node tests/cinematic-v2.cjs",
    "test:cards": "node tests/poster-cards.cjs",
    "test:controller": "node tests/controller-renderer.cjs && node tests/controller-entry.cjs && node tests/controller-layout.cjs",
    "test:languages": "node tests/multilingual-renderer.cjs",
    "test:visual": "node tests/visual-consistency.cjs",
    "test:whats-new": "node tests/whats-new.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright": "1.62.1"
  }
}
