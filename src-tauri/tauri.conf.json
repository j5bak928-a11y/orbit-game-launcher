{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Launcher",
  "version": "0.3.5",
  "identifier": "com.orbitlauncher.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri.cjs",
    "beforeBuildCommand": "node scripts/prepare-tauri.cjs",
    "frontendDist": "../tauri-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbit Launcher",
        "width": 1440,
        "height": 920,
        "minWidth": 910,
        "minHeight": 610,
        "backgroundColor": "#101016",
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
