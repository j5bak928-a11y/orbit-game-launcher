{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Launcher",
  "version": "0.3.6",
  "identifier": "com.orbitlauncher.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri.cjs",
    "beforeBuildCommand": "node scripts/prepare-tauri.cjs",
    "frontendDist": "../tauri-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbit Launcher",
        "width": 1440,
        "height": 920,
        "minWidth": 910,
        "minHeight": 610,
        "backgroundColor": "#101016",
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' orbit-art: http://orbit-art.localhost https://orbit-art.localhost data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3REEyNDBBMUYwRkU2NDIKUldSQzVnOGZDaVRhNTc0aFNDZzdvUFViZk4xRk8wek1JamlYeDRZc3NJS1lWL282aXJMR1hhUEYK",
      "endpoints": [
        "https://github.com/j5bak928-a11y/orbit-game-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
